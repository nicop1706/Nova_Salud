# ============================================================================
#  Nova Salud · variables de entorno
#  Uso:  cp .env.example .env && docker compose up --build
#
#  ⚠  Los valores de abajo son SOLO para demostración local, para que el
#     sistema arranque sin pasos manuales. Antes de exponer el sistema a otra
#     red genera secretos propios:   make secrets   (o:  openssl rand -hex 48)
#     y cambia TODAS las contraseñas.  `.env` está en .gitignore: no lo subas.
# ============================================================================

# --- Base de datos (PostgreSQL 16) ---
POSTGRES_DB=novasalud
POSTGRES_USER=novasalud
POSTGRES_PASSWORD=cambia-esta-clave-de-bd-local

# --- Secretos JWT (mínimo 32 caracteres, distintos entre sí) ---
JWT_ACCESS_SECRET=demo-local-access-secret-CAMBIAR-0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=demo-local-refresh-secret-CAMBIAR-fedcba9876543210fedcba9876543210
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Red y cookies ---
WEB_PORT=8080
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:8080
# true SOLO si publicas detrás de HTTPS (las cookies pasan a ser "Secure")
COOKIE_SECURE=false
# Saltos de proxy confiables (1 = el nginx del compose; nginx sobrescribe X-Forwarded-For)
TRUST_PROXY=1

# --- Límites y protección contra fuerza bruta ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BCRYPT_ROUNDS=12

# --- Negocio ---
STORE_NAME=Nova Salud
STORE_RUC=20000000000
STORE_ADDRESS=Av. Comercial 123, Lima, Perú
STORE_PHONE=(01) 000-0000
IGV_RATE=0.18
# Descuento máximo que puede aplicar un Vendedor (el Administrador no tiene tope)
MAX_SELLER_DISCOUNT_PCT=5
# Umbrales iniciales de alerta de vencimiento (editables luego desde la pantalla Alertas)
EXPIRY_ALERT_DAYS=30,60,90
# Recalculo de alertas (cron, hora de Lima): cada hora
ALERT_CRON=0 * * * *

# --- Arranque ---
AUTO_MIGRATE=true
# Carga datos de demostración solo si la BD está vacía
AUTO_SEED=true
LOG_LEVEL=info

# --- Contraseñas de las cuentas DEMO (cámbialas) ---
SEED_ADMIN_PASSWORD=Admin#2026
SEED_SELLER_PASSWORD=Vendedor#2026
SEED_WAREHOUSE_PASSWORD=Almacen#2026

# --- Adminer (opcional: docker compose --profile tools up -d adminer) ---
ADMINER_PORT=8081
